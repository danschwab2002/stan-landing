# --- Base de datos (SQLite via libsql) ---
# En dev usa un archivo local. En prod (EasyPanel) apunta al volumen persistente:
#   DATABASE_URL=file:/data/stan.db
DATABASE_URL=file:stan.db

# --- Imágenes subidas desde el CMS ---
# Opcional. Si no se setea, se derivan de DATABASE_URL: la carpeta "uploads" al lado
# del archivo de la base (con DATABASE_URL=file:/data/stan.db → /data/uploads).
# Es a propósito: así los archivos caen solos en el volumen persistente, sin config
# extra y sin riesgo de que terminen en el filesystem efímero del contenedor.
# UPLOADS_DIR=/data/uploads

# --- Auth del panel /admin ---
# Contraseña de acceso al CMS. Elegí una fuerte; es el único gate del panel.
ADMIN_PASSWORD=cambiame

# Clave para firmar la cookie de sesión (HMAC-SHA256). Generala con:
#   openssl rand -hex 32
# Si falta ADMIN_PASSWORD o SESSION_SECRET, el panel queda cerrado para todos (fail-closed).
SESSION_SECRET=
